# Supabase (Project Settings -> API). Use the SERVICE ROLE key. Never put it in frontend code or Netlify.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Admin panel login
ADMIN_PASSWORD=choose-a-long-password
ADMIN_TOKEN_SECRET=any-long-random-string
ADMIN_COMPANY_NAME=Digi Sanchaar

# Frontend on Netlify. FRONTEND_URL = who may call this API (CORS). PUBLIC_BASE_URL = base of partner links.
FRONTEND_URL=https://offers.digisanchaar.online
PUBLIC_BASE_URL=https://offers.digisanchaar.online
# Optional: public URL of this backend if you use your own domain for it (otherwise the onrender.com URL is used)
API_PUBLIC_URL=

# Secret placed inside every postback URL. Set a long random value.
POSTBACK_SECRET=change-me-long-random

# Smallest wallet withdrawal a partner can request (rupees)
MIN_WITHDRAWAL=50

# Google Sheets push (Apps Script web app URL + the same secret you set in SheetsReceiver.gs)
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
SHEETS_SECRET=same-secret-as-in-apps-script

TZ_NAME=Asia/Kolkata
PORT=3000
