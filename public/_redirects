# Real static files first (never rewritten)
/css/*   /css/:splat   200
/js/*    /js/:splat    200

# Old query-style links -> new path-style links
/   cid=:cid ref=:ref   /:cid/:ref   301
/   cid=:cid            /:cid/DIRECT 301
/   page=gen            /gen         301
/   page=ref            /referral    301
/   page=mydashboard    /referral    301

# Admin page only through the secret path
/admin.html    /404.html    404!
/admin         /404.html    404!

# Pages (clean targets, no .html, so Cloudflare does not redirect)
/terms          /terms           200
/privacy        /privacy         200
/refund-policy  /refund-policy   200
/contact        /contact         200
/admin/DGSNR    /admin           200
/referral       /dashboard       200
/gen/:cid       /linkgen         200
/gen            /linkgen         200
/tracker/:cid   /tracker         200
/:cid/:ref      /prelander       200
